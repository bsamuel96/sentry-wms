{
  "expo": {
    "name": "Autosav WMS",
    "slug": "sentry-wms",
    "version": "1.50.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.autosavcar.sentrywms"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b63d6"
      },
      "package": "ro.autosavcar.sentrywms",
      "versionCode": 44,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite aplica\u021biei Autosav WMS s\u0103 foloseasc\u0103 camera pentru scanarea etichetelor.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite aplica\u021biei Autosav WMS s\u0103 aleag\u0103 fotografia produsului pentru echivalarea manual\u0103.",
          "cameraPermission": "Permite aplica\u021biei Autosav WMS s\u0103 fotografieze produsul pentru echivalarea manual\u0103.",
          "microphonePermission": false
        }
      ],
      "./plugins/chainway-scanner",
      "./plugins/with-cleartext-traffic"
    ],
    "extra": {
      "eas": {
        "projectId": "4a4c288d-efc4-46e5-93ee-b2550697cfe6"
      }
    },
    "owner": "gsam"
  }
}
