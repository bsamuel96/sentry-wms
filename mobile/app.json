{
  "expo": {
    "name": "Sentry WMS",
    "slug": "sentry-wms",
    "version": "1.37.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.autosavcar.sentrywms"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b63d6"
      },
      "package": "ro.autosavcar.sentrywms",
      "versionCode": 14,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite aplicației Sentry WMS să folosească camera pentru scanarea etichetelor.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/chainway-scanner",
      "./plugins/with-cleartext-traffic"
    ]
  }
}
